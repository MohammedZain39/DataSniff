# Set to hosted to require a signed-in account for the scanner. Local keeps scanning available without login.
DATASNIFF_AUTH_MODE=local

# Set a random value for hosted deployments; never commit the real value.
STREAMLIT_SERVER_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional: move SQLite data outside the project directory.
# DATASNIFF_DB_PATH=C:\\path\\to\\datasniff.sqlite3
